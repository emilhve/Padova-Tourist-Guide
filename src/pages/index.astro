---
import { getCollection } from 'astro:content';
import Map from '../components/Map.astro';
import PlaceCard from '../components/PlaceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const mapPoints = places.map((place) => ({
  title: place.data.title,
  href: `/places/${place.id}/`,
  latitude: place.data.coordinates.latitude,
  longitude: place.data.coordinates.longitude,
}));
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <h1>En praktisk guide til å utforske Padova</h1>
    </div>
  </section>

  <section id="places" class="section shell" aria-labelledby="places-title">
    <div class="section-heading">
      <h2 id="places-title">Landemerker det er verdt å se</h2>
    </div>
    <div class="card-grid">
      {places.map((place) => <PlaceCard id={place.id} {...place.data} />)}
    </div>
  </section>

  <section id="map" class="section shell" aria-labelledby="map-title">
    <div class="section-heading">
      <h2 id="map-title">Utforsk kartet</h2>
    </div>
    <Map points={mapPoints} />
  </section>
</BaseLayout>
