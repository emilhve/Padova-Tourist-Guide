---
import { getCollection } from 'astro:content';
import Map from '../components/Map.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const categoryLabels = {
  landmark: 'Landemerke',
  museum: 'Museum',
  church: 'Kirke',
  food: 'Mat',
  park: 'Park',
};

const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const mapPoints = places.map((place) => ({
  title: place.data.title,
  href: `/places/${place.id}/`,
  latitude: place.data.coordinates.latitude,
  longitude: place.data.coordinates.longitude,
}));
---

<BaseLayout
  title="Ruteplanlegger"
  description="Velg stedene du vil besøke i Padova, og lag en rute til fots eller på sykkel."
  lang="no"
>
  <header class="planner-heading shell">
    <p class="eyebrow">Planlegg dagen</p>
    <h1>Velg stoppene dine i Padova.</h1>
    <p class="lead">
      Velg stedene du vil besøke, velg ett av dem som startsted, og bestem om du vil gå eller sykle.
    </p>
    <div class="planner-notice" role="note">
      <strong>Før du beregner ruten:</strong> Velg minst to severdigheter. Startstedet må være ett
      av stedene du har valgt.
    </div>
  </header>

  <section class="planner-section shell" aria-labelledby="selection-title">
    <div class="planner-grid">
      <form id="route-selection" class="planner-card">
        <div class="planner-card-heading">
          <p class="eyebrow">Steg 1</p>
          <h2 id="selection-title">Severdigheter</h2>
        </div>

        <details class="poi-dropdown">
          <summary>
            <span>Velg severdigheter</span>
            <span class="poi-count" aria-live="polite">0 valgt</span>
          </summary>

          <div class="poi-menu">
            <div class="poi-actions" aria-label="Velg eller fjern alle severdigheter">
              <button type="button" data-select-all>Velg alle</button>
              <button type="button" data-deselect-all disabled>Fjern alle valg</button>
            </div>

            <fieldset class="poi-options">
              <legend class="visually-hidden">Velg severdigheter</legend>
              {
                places.map((place) => (
                  <label class="poi-option">
                    <input
                      type="checkbox"
                      name="placeIds"
                      value={place.id}
                      data-title={place.data.title}
                    />
                    <span>
                      <strong>{place.data.title}</strong>
                      <small>{categoryLabels[place.data.category]}</small>
                    </span>
                  </label>
                ))
              }
            </fieldset>
          </div>
        </details>

        <p id="selection-help" class="field-help">Velg minst to steder for å lage en rute.</p>

        <div class="start-field">
          <label for="route-start">
            <span class="eyebrow">Steg 2</span>
            <strong>Startsted</strong>
          </label>
          <select id="route-start" name="startPlaceId" disabled>
            <option value="">Velg et av de valgte stedene</option>
          </select>
          <p class="field-help">Bare steder du valgte i steg 1 vises her.</p>
        </div>

        <fieldset class="travel-mode">
          <legend>
            <span class="eyebrow">Steg 3</span>
            <strong>Reisemåte</strong>
          </legend>
          <div class="mode-options">
            <label>
              <input type="radio" name="mode" value="walking" checked />
              <span>Til fots</span>
            </label>
            <label>
              <input type="radio" name="mode" value="cycling" />
              <span>Sykkel</span>
            </label>
          </div>
        </fieldset>

        <button class="button calculate-button" type="submit" disabled>
          Beregn ruten min
        </button>
        <p class="planner-status" aria-live="polite"></p>

        <section class="route-results" aria-labelledby="route-results-title" hidden>
          <p class="eyebrow">Beregnet rute</p>
          <h3 id="route-results-title">Din reiserute</h3>
          <dl class="route-totals">
            <div>
              <dt>Distanse</dt>
              <dd data-route-distance></dd>
            </div>
            <div>
              <dt>Beregnet tid</dt>
              <dd data-route-duration></dd>
            </div>
          </dl>
          <ol class="route-stop-list" data-route-stops></ol>
        </section>
      </form>

      <div class="planner-map">
        <Map points={mapPoints} routePlanning ariaLabel="Interaktivt kart over severdigheter i Padova" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { LineString } from 'geojson';

  interface RouteResponse {
    mode: 'walking' | 'cycling';
    orderedStops: Array<{
      id: string;
      title: string;
      longitude: number;
      latitude: number;
    }>;
    geometry: LineString;
    totalDistanceMeters: number;
    totalDurationSeconds: number;
  }

  const form = document.querySelector<HTMLFormElement>('#route-selection');

  if (form) {
    const dropdown = form.querySelector<HTMLDetailsElement>('.poi-dropdown');
    const checkboxes = [...form.querySelectorAll<HTMLInputElement>('input[name="placeIds"]')];
    const count = form.querySelector<HTMLElement>('.poi-count');
    const startSelect = form.querySelector<HTMLSelectElement>('#route-start');
    const calculateButton = form.querySelector<HTMLButtonElement>('.calculate-button');
    const selectAllButton = form.querySelector<HTMLButtonElement>('[data-select-all]');
    const deselectAllButton = form.querySelector<HTMLButtonElement>('[data-deselect-all]');
    const status = form.querySelector<HTMLElement>('.planner-status');
    const routeResults = form.querySelector<HTMLElement>('.route-results');
    const routeDistance = form.querySelector<HTMLElement>('[data-route-distance]');
    const routeDuration = form.querySelector<HTMLElement>('[data-route-duration]');
    const routeStops = form.querySelector<HTMLOListElement>('[data-route-stops]');
    let calculating = false;

    const resetResult = () => {
      if (status) {
        status.textContent = '';
        delete status.dataset.state;
      }
      if (routeResults) routeResults.hidden = true;
    };

    const updateCalculateButton = () => {
      const selectedCount = checkboxes.filter((checkbox) => checkbox.checked).length;
      if (calculateButton) {
        calculateButton.disabled = calculating || selectedCount < 2 || !startSelect?.value;
      }
    };

    const updateSelection = () => {
      const selected = checkboxes.filter((checkbox) => checkbox.checked);
      const selectedCount = selected.length;
      const previousStart = startSelect?.value ?? '';

      if (startSelect) {
        startSelect.length = 1;

        for (const checkbox of selected) {
          startSelect.add(new Option(checkbox.dataset.title ?? checkbox.value, checkbox.value));
        }

        startSelect.disabled = selectedCount < 2;
        startSelect.value = selected.some((checkbox) => checkbox.value === previousStart)
          ? previousStart
          : '';
      }

      if (count) count.textContent = `${selectedCount} valgt`;
      updateCalculateButton();
      if (selectAllButton) selectAllButton.disabled = selectedCount === checkboxes.length;
      if (deselectAllButton) deselectAllButton.disabled = selectedCount === 0;
      resetResult();
    };

    for (const checkbox of checkboxes) checkbox.addEventListener('change', updateSelection);

    startSelect?.addEventListener('change', () => {
      updateCalculateButton();
      resetResult();
    });

    for (const mode of form.querySelectorAll<HTMLInputElement>('input[name="mode"]')) {
      mode.addEventListener('change', resetResult);
    }

    selectAllButton?.addEventListener('click', () => {
      for (const checkbox of checkboxes) checkbox.checked = true;
      updateSelection();
    });

    deselectAllButton?.addEventListener('click', () => {
      for (const checkbox of checkboxes) checkbox.checked = false;
      updateSelection();
    });

    document.addEventListener('click', (event) => {
      if (dropdown?.open && event.target instanceof Node && !dropdown.contains(event.target)) {
        dropdown.open = false;
      }
    });

    dropdown?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        dropdown.open = false;
        dropdown.querySelector<HTMLElement>('summary')?.focus();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const selected = checkboxes.filter((checkbox) => checkbox.checked);
      const selectedCount = selected.length;
      const startingPoint = startSelect?.selectedOptions[0]?.textContent;
      const mode = new FormData(form).get('mode');

      if (
        selectedCount < 2 ||
        !startSelect?.value ||
        !startingPoint ||
        (mode !== 'walking' && mode !== 'cycling')
      ) {
        return;
      }

      if (dropdown) dropdown.open = false;
      calculating = true;
      updateCalculateButton();
      if (calculateButton) calculateButton.textContent = 'Beregner rute…';
      if (status) {
        status.dataset.state = 'loading';
        const modeLabel = mode === 'walking' ? 'gårute' : 'sykkelrute';
        status.textContent = `Beregner en ${modeLabel} fra ${startingPoint}…`;
      }
      if (routeResults) routeResults.hidden = true;

      try {
        const response = await fetch('/api/route', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            placeIds: selected.map((checkbox) => checkbox.value),
            startPlaceId: startSelect.value,
            mode,
          }),
        });
        const result = (await response.json()) as RouteResponse | { error?: string };

        if (!response.ok || !('geometry' in result)) {
          throw new Error('error' in result && result.error ? result.error : 'Ruten kunne ikke beregnes.');
        }

        if (routeDistance) {
          routeDistance.textContent =
            result.totalDistanceMeters >= 1_000
              ? `${(result.totalDistanceMeters / 1_000).toFixed(1)} km`
              : `${Math.round(result.totalDistanceMeters)} m`;
        }

        if (routeDuration) {
          const totalMinutes = Math.max(1, Math.round(result.totalDurationSeconds / 60));
          const hours = Math.floor(totalMinutes / 60);
          const minutes = totalMinutes % 60;
          routeDuration.textContent = hours > 0 ? `${hours} t ${minutes} min` : `${minutes} min`;
        }

        if (routeStops) {
          routeStops.replaceChildren(
            ...result.orderedStops.map((stop, index) => {
              const item = document.createElement('li');
              const name = document.createElement('span');
              name.textContent = stop.title;
              item.append(name);

              if (index === 0) {
                const badge = document.createElement('small');
                badge.textContent = 'Start';
                item.append(badge);
              }

              return item;
            }),
          );
        }

        if (routeResults) routeResults.hidden = false;
        if (status) {
          status.dataset.state = 'success';
          status.textContent = 'Ruten er beregnet.';
        }

        window.dispatchEvent(new CustomEvent('planner:route', { detail: result }));
      } catch (error) {
        if (status) {
          status.dataset.state = 'error';
          status.textContent =
            error instanceof Error ? error.message : 'Ruten kunne ikke beregnes.';
        }
      } finally {
        calculating = false;
        if (calculateButton) calculateButton.textContent = 'Beregn ruten min';
        updateCalculateButton();
      }
    });

    updateSelection();
  }
</script>
