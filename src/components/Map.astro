---
import 'maplibre-gl/dist/maplibre-gl.css';

interface MapPoint {
  title: string;
  href: string;
  latitude: number;
  longitude: number;
}

interface Props {
  points: MapPoint[];
  routePlanning?: boolean;
}

const { points, routePlanning = false } = Astro.props;
---

<div
  id="guide-map"
  class="map"
  data-points={JSON.stringify(points)}
  data-route-planning={String(routePlanning)}
  aria-label="Interactive map of featured places in Padova"
></div>

<script>
  import {
    LngLatBounds,
    Map as MapLibreMap,
    Marker,
    NavigationControl,
    Popup,
    setWorkerUrl,
  } from 'maplibre-gl';
  import type { Feature, LineString } from 'geojson';
  import type { GeoJSONSource } from 'maplibre-gl';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';

  interface MapPoint {
    title: string;
    href: string;
    latitude: number;
    longitude: number;
  }

  interface PlannedRoute {
    geometry: LineString;
  }

  const container = document.querySelector<HTMLElement>('#guide-map');

  if (container) {
    setWorkerUrl(workerUrl);

    const points = JSON.parse(container.dataset.points ?? '[]') as MapPoint[];
    const styleUrl =
      import.meta.env.PUBLIC_MAP_STYLE_URL ?? 'https://tiles.openfreemap.org/styles/liberty';
    const map = new MapLibreMap({
      container,
      style: styleUrl,
      center: [11.8768, 45.4064],
      zoom: 12.5,
    });

    map.addControl(new NavigationControl(), 'top-right');

    for (const point of points) {
      const popupContent = document.createElement('a');
      popupContent.href = point.href;
      popupContent.textContent = point.title;

      new Marker({ color: '#b43a2f' })
        .setLngLat([point.longitude, point.latitude])
        .setPopup(new Popup({ offset: 24 }).setDOMContent(popupContent))
        .addTo(map);
    }

    if (container.dataset.routePlanning === 'true') {
      const drawRoute = (route: PlannedRoute) => {
        const feature: Feature<LineString> = {
          type: 'Feature',
          properties: {},
          geometry: route.geometry,
        };
        const existingSource = map.getSource('planned-route') as GeoJSONSource | undefined;

        if (existingSource) {
          existingSource.setData(feature);
        } else {
          map.addSource('planned-route', { type: 'geojson', data: feature });
          map.addLayer({
            id: 'planned-route-outline',
            type: 'line',
            source: 'planned-route',
            paint: {
              'line-color': '#fffaf1',
              'line-width': 8,
              'line-opacity': 0.9,
            },
          });
          map.addLayer({
            id: 'planned-route-line',
            type: 'line',
            source: 'planned-route',
            paint: {
              'line-color': '#b43a2f',
              'line-width': 5,
            },
          });
        }

        const bounds = new LngLatBounds();
        for (const coordinate of route.geometry.coordinates) {
          bounds.extend([coordinate[0], coordinate[1]]);
        }

        if (!bounds.isEmpty()) {
          map.fitBounds(bounds, { padding: 60, maxZoom: 16, duration: 700 });
        }
      };

      window.addEventListener('planner:route', (event) => {
        const route = (event as CustomEvent<PlannedRoute>).detail;
        if (!route?.geometry) return;

        if (map.loaded()) drawRoute(route);
        else map.once('load', () => drawRoute(route));
      });
    }
  }
</script>
