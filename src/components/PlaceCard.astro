---
import { formatCategory } from '../utils/formatCategory';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
}

const { id, title, description, category } = Astro.props;
---

<article class="place-card">
  <p class="eyebrow">{formatCategory(category)}</p>
  <h3><a href={`/places/${id}/`}>{title}</a></h3>
  <p>{description}</p>
  <a class="text-link" href={`/places/${id}/`}>Explore this place <span aria-hidden="true">→</span></a>
</article>
