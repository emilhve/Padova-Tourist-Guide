---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'Padova Tourist Guide',
  description = 'Oppdag severdigheter, historier og opplevelser i Padova.',
  lang = 'no',
} = Astro.props;

const pageTitle = title === 'Padova Tourist Guide' ? title : `${title} | Padova Tourist Guide`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Padova Tourist Guide – forside">
        <span class="brand-mark" aria-hidden="true">P</span>
        <span>Padova Tourist Guide</span>
      </a>
      <nav aria-label="Hovednavigasjon">
        <a href="/#places">Steder</a>
        <a href="/#map">Kart</a>
        <a href="/planner/">Ruteplanlegger</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Laget for nysgjerrige besøkende i Padova.</p>
    </footer>
  </body>
</html>
